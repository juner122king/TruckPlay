{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TruckPlay",
  "version": "1.0.0-rc.1",
  "identifier": "io.github.juner122king.truckplay",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui/dist",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../ui",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "npm run build:release",
      "cwd": "../ui"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TruckPlay",
        "width": 780,
        "height": 520,
        "minWidth": 640,
        "minHeight": 420,
        "resizable": true,
        "maximizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "publisher": "juner122king",
    "copyright": "Copyright © 2026 TruckPlay (based on WestPlay, GPL-3.0-or-later).",
    "category": "Game",
    "shortDescription": "TruckPlay — CarPlay-style in-cabin screen for ETS2 and ATS",
    "longDescription": "TruckPlay brings in-cabin maps, speed cameras, traffic lights, freight HUD, Apple Music, YouTube, Bilibili, NetEase Cloud Music, QQ Music, Radio and local playback to ETS2 and ATS.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../ui/dist/": "ui/",
      "../target/release/westplay.dll": "westplay.dll"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwMDhGMEUzQzFBMzNBQzQKUldURU9xUEI0L0FJd0tMOUJHcDJTQ1NCSGtoUllVUnVOL25SejZHdC9iVmFYdlBtZ1daR0doZzcK",
      "endpoints": [
        "https://github.com/juner122king/TruckPlay/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
