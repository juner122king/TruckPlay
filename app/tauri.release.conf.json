{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": {
      "../target/release/westplay.dll": "westplay.dll",
      "../target/release/westplay-probe.exe": "westplay-probe.exe",
      "../target/release/westplay-maps.exe": "westplay-maps.exe",
      "../LICENSE": "LICENSE.txt",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md",
      "../crates/host/src/ximalaya_hls.LICENSE": "licenses/hls.js.LICENSE"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer/hooks.nsh",
        "displayLanguageSelector": false,
        "languages": ["English", "SimpChinese"]
      }
    }
  }
}
